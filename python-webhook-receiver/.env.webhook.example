# === HubSpot ===
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx

# === Webhook Receiver ===
WEBHOOK_URL=https://your-domain.com/webhooks/hubspot

# === AWS SQS ===
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/hubspot-webhook-events
SQS_REGION=us-west-2

# === PostgreSQL ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_db
DB_USER=etl_user
DB_PASS=your-db-password
DB_SCHEMA=hubspot_etl

# === Batching ===
BATCH_MAX_EVENTS=100
BATCH_WAIT_SECONDS=60
POLL_WAIT_SECONDS=20

# === Logging ===
LOG_LEVEL=INFO

# === Testing (ONLY for local development with LocalStack) ===
# SKIP_SIGNATURE_VALIDATION=true
